# ==============================================================================
# Google Ads API Financial Transaction Upper Limits Configuration
# ==============================================================================
# Specify upper limits for financial transactions across Google Ads API services.
# All values MUST be in the exact numeric format required by the Google Ads API
# call for each service (see the monetary unit noted for each entry below).
#
# If any mutation attempts a financial transaction exceeding a configured upper
# limit (> 0), the mutate functions and HITL guard will return an error, inform
# the user at the HITL step, and refuse to execute the command.
#
# Setting a value to 0 (or 0.0 for float fields) means NO upper limit is enforced
# for that transaction type (unlimited).
#
# MONETARY & NUMERIC UNITS USED BY GOOGLE ADS API SERVICES:
# 1. micros (int64):
#    1 unit of account currency = 1,000,000 micros (e.g., 50000000 = 50.00 currency units).
# 2. currency_units (double / float):
#    Standard account/conversion currency units (NOT micros; e.g., 100.50 = 100.50 currency units).
# 3. decimal_ratio (double / float):
#    Decimal ratio or multiplier (e.g., 2.5 = 250% Target ROAS; 1.5 = +50% bid modifier).
# 4. micros_proportion (int64):
#    Proportion in micros where 1,000,000 = 100% (e.g., 200000 = 20% Percent CPC bid).
# ==============================================================================

# --- 1. Global Fallback Upper Limits (Optional) ---

# Service: All Google Ads API services using micros-denominated monetary fields
# API Fields: Any *_micros monetary field when its specific limit below is set to 0
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency)
all_micros_transactions = 0

# Service: All Google Ads API services using standard currency unit fields
# API Fields: Any standard currency unit field when its specific limit below is set to 0.0
# Monetary Unit: currency_units (double/float, 1.0 = 1.00 unit of account currency, NOT micros)
all_currency_unit_transactions = 0.0

# --- 2. Budgets, Account Spending Limits & Guaranteed Reservations ---

# Service: CampaignBudgetService (mutate_campaign_budgets), GoogleAdsService (mutate), ExperimentService (graduate_experiment)
# API Fields: amount_micros, recommended_budget_amount_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 100000000 = 100.00/day)
campaign_budget_amount_micros = 0

# Service: CampaignBudgetService (mutate_campaign_budgets), GoogleAdsService (mutate)
# API Field: total_amount_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 1000000000 = 1,000.00 lifetime total)
campaign_budget_total_amount_micros = 0

# Service: AccountBudgetProposalService (mutate_account_budget_proposal)
# API Fields: proposed_spending_limit_micros, approved_spending_limit_micros, spending_limit_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 25000000000 = 25,000.00 account limit)
account_budget_spending_limit_micros = 0

# Service: ReservationService (book_campaigns, quote_campaigns)
# API Field: max_budget_micros (and booked campaign budget amount_micros / total_amount_micros)
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 10000000000 = 10,000.00 reservation commitment)
reservation_booking_max_budget_micros = 0

# --- 3. Bidding & Bid Ceilings (Micros) ---

# Services: AdGroupService (mutate_ad_groups), AdGroupCriterionService (mutate_ad_group_criteria), CampaignCriterionService (mutate_campaign_criteria), GoogleAdsService (mutate)
# API Fields: cpc_bid_micros, target_cpc_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 10000000 = 10.00 max CPC)
cpc_bid_micros = 0

# Services: AdGroupService, AdGroupCriterionService, BiddingStrategyService, CampaignService, GoogleAdsService
# API Fields: cpm_bid_micros, target_cpm_micros, fixed_cpm_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency per 1,000 impressions; e.g., 20000000 = 20.00 CPM)
cpm_bid_micros = 0

# Services: AdGroupService, AdGroupCriterionService, CampaignService, GoogleAdsService
# API Fields: cpv_bid_micros, target_cpv_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 2000000 = 2.00 CPV)
cpv_bid_micros = 0

# Services: BiddingStrategyService (mutate_bidding_strategies), CampaignService (mutate_campaigns), AdGroupService (mutate_ad_groups), GoogleAdsService (mutate)
# API Fields: target_cpa_micros, manual_cpa_bid_micros, target_cpa_bid_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 50000000 = 50.00 Target CPA)
target_cpa_micros = 0

# Services: BiddingStrategyService, CampaignService, GoogleAdsService (TargetCpa, TargetRoas, TargetSpend, TargetImpressionShare, MaximizeConversions, MaximizeConversionValue, PercentCpc)
# API Fields: cpc_bid_ceiling_micros, cpc_bid_floor_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 15000000 = 15.00 CPC bid ceiling)
cpc_bid_ceiling_micros = 0

# Services: BiddingStrategyService, CampaignService, GoogleAdsService (TargetSpend)
# API Field: target_spend_micros
# Monetary Unit: micros (int64, 1,000,000 micros = 1.00 unit of account currency; e.g., 100000000 = 100.00 target spend)
target_spend_micros = 0

# --- 4. Percentage-Based Bidding (Micros Proportion) ---

# Services: AdGroupService, AdGroupCriterionService, CampaignService, GoogleAdsService (PercentCpc, TargetImpressionShare)
# API Fields: percent_cpc_bid_micros, location_fraction_micros
# Monetary Unit: micros_proportion (int64, 1,000,000 = 100%; e.g., 250000 = 25% of item/hotel price)
percent_cpc_bid_micros = 0

# --- 5. Conversions, Restatements & Value Rules (Standard Currency Units) ---

# Service: ConversionUploadService (upload_click_conversions, upload_call_conversions)
# API Field: conversion_value
# Monetary Unit: currency_units (double/float, standard currency units, NOT micros; e.g., 500.0 = 500.00 currency units)
conversion_upload_value = 0.0

# Service: ConversionAdjustmentUploadService (upload_conversion_adjustments)
# API Field: adjusted_value (restatement_value.adjusted_value)
# Monetary Unit: currency_units (double/float, standard currency units, NOT micros; e.g., 500.0 = 500.00 currency units)
conversion_adjustment_restatement_value = 0.0

# Service: ConversionActionService (mutate_conversion_actions), GoogleAdsService (mutate)
# API Field: default_value (value_settings.default_value)
# Monetary Unit: currency_units (double/float, standard currency units, NOT micros; e.g., 100.0 = 100.00 currency units)
conversion_action_default_value = 0.0

# Service: ConversionValueRuleService (mutate_conversion_value_rules), GoogleAdsService (mutate)
# API Field: value (action.value)
# Monetary Unit: currency_units (for ADD/SET operations) or decimal_ratio (for MULTIPLY operation) (double/float, NOT micros; e.g., 100.0)
conversion_value_rule_action_value = 0.0

# --- 6. ROAS Targets, Bid Modifiers & Seasonality Multipliers (Decimal Ratio) ---

# Services: BiddingStrategyService, CampaignService, AdGroupService, GoogleAdsService (TargetRoas, MaximizeConversionValue)
# API Field: target_roas
# Monetary Unit: decimal_ratio (double/float, conversion value per 1.00 currency unit spent; e.g., 5.0 = 500% ROAS)
target_roas = 0.0

# Services: CampaignBidModifierService, AdGroupBidModifierService, CampaignCriterionService, AdGroupCriterionService, GoogleAdsService
# API Field: bid_modifier
# Monetary Unit: decimal_ratio (double/float, bid multiplier; e.g., 2.0 = +100% bid adjustment)
bid_modifier = 0.0

# Service: BiddingSeasonalityAdjustmentService (mutate_bidding_seasonality_adjustments), GoogleAdsService (mutate)
# API Fields: conversion_rate_modifier, seasonality_modifier
# Monetary Unit: decimal_ratio (double/float, conversion rate multiplier; e.g., 1.5 = +50% seasonality adjustment)
seasonality_conversion_rate_modifier = 0.0
