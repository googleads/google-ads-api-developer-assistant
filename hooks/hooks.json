{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "session-start-touch",
            "type": "command",
            "command": "touch /tmp/session_start.debug",
            "description": "Test SessionStart with touch",
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "session-end-touch",
            "type": "command",
            "command": "touch /tmp/session_end.debug",
            "description": "Test SessionEnd with touch",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}